<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 注意: 不启用 TreatWarningsAsErrors，因为 MaterialDesignThemes 可能产生警告 -->
    <NoWarn>$(NoWarn);NU1902;NU1903;NU1701;NU1603;CS8618;CS8602;CS8604</NoWarn>
  </PropertyGroup>
</Project>
