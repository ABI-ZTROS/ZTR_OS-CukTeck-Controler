<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable,CS0168,CS0414,CS0618,CS8618</WarningsAsErrors>
    <!-- 排除 NuGet 安全公告警告（NU1902 等），仅在生产发布中检查 -->
    <NoWarn>$(NoWarn);NU1902;NU1903;NU1701;NU1603</NoWarn>
  </PropertyGroup>
</Project>
