<Application x:Class="CukTechController.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CukTechController"
             xmlns:v="clr-namespace:CukTechController.Views"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 🎨 Material Design 3 深色主题（MSMC BundledTheme 方式）-->
                <materialDesign:BundledTheme BaseTheme="Dark"
                                              PrimaryColor="Blue"
                                              SecondaryColor="Purple" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
                <!-- 酷态科自定义主题覆盖 -->
                <ResourceDictionary Source="ui/Themes/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 全局值转换器 -->
            <v:InvertBoolConverter x:Key="InvertBoolConv"/>
            <v:StringToVisibilityConverter x:Key="StringToVis"/>
            <v:BoolToConnTextConverter x:Key="BoolToConnText"/>
            <v:BoolToOnOffConverter x:Key="BoolToOnOffConv"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
