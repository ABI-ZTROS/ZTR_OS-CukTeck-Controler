<Application x:Class="CukTechController.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CukTechController"
             xmlns:v="clr-namespace:CukTechController.UI.Views"
             xmlns:mdi="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             StartupUri="ui/Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 🎨 Material Design 深色主题（MSMC 同款基础）-->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Dark.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <!-- 酷态科自定义主题覆盖 -->
                <ResourceDictionary Source="ui/Themes/AppTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- 全局值转换器 -->
            <v:InvertBoolConverter x:Key="InvertBoolConv"/>
            <v:StringToVisibilityConverter x:Key="StringToVis"/>
            <v:BoolToConnTextConverter x:Key="BoolToConnText"/>
            <v:BoolToOnOffConverter x:Key="BoolToOnOffConv"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
