<UserControl x:Class="CukTechController.Controls.ChargerVisualControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinWidth="200" MinHeight="200">

    <Canvas x:Name="Canvas" ClipToBounds="True">
        
        <!-- 外壳背景（圆角矩形）-->
        <Rectangle x:Name="Casing"
                   Canvas.Left="30" Canvas.Top="50"
                   Width="240" Height="200"
                   RadiusX="28" RadiusY="28"
                   Fill="#FF1E293B" Stroke="#14FFFFFF" StrokeThickness="1"/>

        <!-- 外壳顶部高光 -->
        <Rectangle Canvas.Left="30" Canvas.Top="50"
                   Width="240" Height="40"
                   RadiusX="28" RadiusY="28"
                   Fill="#22FFFFFF" Opacity="0.3"/>

        <!-- 内机身深色 -->
        <Rectangle x:Name="InnerBody"
                   Canvas.Left="42" Canvas.Top="62"
                   Width="216" Height="176"
                   RadiusX="20" RadiusY="20"
                   Fill="#FF020617"/>

        <!-- C1 USB-C 口 (左) -->
        <Ellipse x:Name="PortC1"
                 Canvas.Left="96" Canvas.Top="112"
                 Width="28" Height="28"
                 Fill="Transparent"/>

        <!-- C2 USB-C 口 (中) -->
        <Ellipse x:Name="PortC2"
                 Canvas.Left="161" Canvas.Top="112"
                 Width="28" Height="28"
                 Fill="Transparent"/>

        <!-- C3 USB-C 口 (右) -->
        <Ellipse x:Name="PortC3"
                 Canvas.Left="226" Canvas.Top="112"
                 Width="28" Height="28"
                 Fill="Transparent"/>

        <!-- A口 (右下矩形) -->
        <Rectangle x:Name="PortA"
                   Canvas.Left="247" Canvas.Top="161"
                   Width="26" Height="18"
                   RadiusX="4" RadiusY="4"
                   Fill="Transparent"/>

        <!-- C1 LED -->
        <Ellipse x:Name="LedC1" Canvas.Left="102" Canvas.Top="86"
                 Width="16" Height="16" Fill="#FF374151"/>

        <!-- C2 LED -->
        <Ellipse x:Name="LedC2" Canvas.Left="167" Canvas.Top="86"
                 Width="16" Height="16" Fill="#FF374151"/>

        <!-- C3 LED -->
        <Ellipse x:Name="LedC3" Canvas.Left="232" Canvas.Top="86"
                 Width="16" Height="16" Fill="#FF374151"/>

        <!-- A LED -->
        <Ellipse x:Name="LedA" Canvas.Left="250" Canvas.Top="154"
                 Width="16" Height="16" Fill="#FF374151"/>

        <!-- 中心能量点 -->
        <Ellipse x:Name="CenterEnergy" Canvas.Left="146" Canvas.Top="156"
                 Width="20" Height="20" Opacity="0.15"/>

        <!-- LOGO 文字区域背景线 -->
        <Line Canvas.Left="120" Canvas.Top="230"
              X1="120" Y1="230" X2="180" Y2="230"
              Stroke="#1AFFFFFF" StrokeThickness="0.5"/>
    </Canvas>
</UserControl>
