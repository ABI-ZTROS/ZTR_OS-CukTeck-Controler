<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== ColorOS 15 深色主题调色板 ===== -->
    <!-- 背景 -->
    <Color x:Key="BgBackgroundColor">#FF0A0F1E</Color>
    <Color x:Key="SurfaceColor">#FF111827</Color>
    <Color x:Key="CardColor">#FF1F2937</Color>
    <Color x:Key="BorderSubtle">#374151</Color>

    <!-- 功能色 -->
    <Color x:Key="AccentBlue">#FF3B82F6</Color>       <!-- 电光蓝 -->
    <Color x:Key="AccentBlueDark">#FF1D4ED8</Color>
    <Color x:Key="AccentGreen">#FF10B981</Color>      <!-- 翡翠绿（充电中）-->
    <Color x:Key="AccentOrange">#FFF59E0B</Color>    <!-- 琥珀橙 -->
    <Color x:Key="AccentRed">#FFEF4444</Color>       <!-- 警示红 -->
    <Color x:Key="AccentPurple">#FF8B5CF6</Color>    <!-- 霓虹紫 -->

    <!-- 文字 -->
    <Color x:Key="TextPrimary">#FFF9FAFB</Color>
    <Color x:Key="TextSecondary">#FF9CA3AF</Color>
    <Color x:Key="TextDisabled">#FF6B7280</Color>

    <!-- ===== Brush ===== -->
    <!-- 背景 -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BgBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>

    <!-- 功能色 — 完整套（Color→Brush，方便 C# 代码直接 FindResource）-->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="AccentBlueDarkBrush" Color="{StaticResource AccentBlueDark}"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="ConnectedBrush" Color="{StaticResource AccentGreen}"/>
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentOrange}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource AccentOrange}"/>
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRed}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource AccentRed}"/>
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}"/>

    <!-- 状态 -->
    <SolidColorBrush x:Key="DisconnectedBrush" Color="#FF6B7280"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabled}"/>

    <!-- ===== ColorOS 动画 Easing ===== -->
    <!-- ColorOS FastOutSlowIn = Cubic(0.4, 0.0, 0.2, 1.0) -->
    <CubicEase x:Key="ColorOSStandardEase" EasingMode="EaseInOut"
/>
    <!-- ColorOS LinearOutSlowIn = Cubic(0.0, 0.0, 0.2, 1.0) -->
    <CubicEase x:Key="ColorOSEnterEase" EasingMode="EaseOut"
/>
    <!-- ColorOS FastOutLinearIn = Cubic(0.4, 0.0, 1.0, 1.0) -->
    <CubicEase x:Key="ColorOSExitEase" EasingMode="EaseIn"
/>

    <!-- ===== 默认 Button Style（ColorOS 柔性） ===== -->
    <Style TargetType="Button" x:Key="ColorOSButton">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 端口卡片样式（全局） ===== -->
    <Style TargetType="Border" x:Key="PortCardStyle">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderBrush" Value="#40374151"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

</ResourceDictionary>
