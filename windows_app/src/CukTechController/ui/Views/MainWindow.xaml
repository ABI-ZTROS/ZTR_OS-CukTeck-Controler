<Window x:Class="CukTechController.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CukTechController.ViewModels"
        xmlns:v="clr-namespace:CukTechController.Views"
        Title="酷态科控制器" Height="700" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <Style x:Key="PortCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource DisconnectedBrush}"/>
        </Style>
        <Style x:Key="PortCardConnectedBorder" TargetType="Border" BasedOn="{StaticResource PortCardStyle}">
            <Setter Property="BorderBrush" Value="{StaticResource ConnectedBrush}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,12" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="12" Height="12" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource DisconnectedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource ConnectedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="扫描" Command="{Binding ScanCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InvertBoolConv}}"
                            Margin="4,0" Padding="12,6"/>
                    <Button Content="断开" Command="{Binding DisconnectCommand}"
                            Margin="4,0" Padding="12,6"/>
                    <Button Content="设置" Command="{Binding OpenSettingsCommand}"
                            Margin="4,0" Padding="12,6"/>
                    <Button Content="日志" Command="{Binding OpenLogCommand}"
                            Margin="4,0" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Error banner -->
        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource ErrorBrush}"
                   FontSize="14" FontWeight="SemiBold"
                   Margin="16,8"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"/>

        <!-- Port grid: 2x2 -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding Ports}" Margin="8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="2" Margin="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Padding" Value="16"/>
                                <Setter Property="Margin" Value="8"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="{StaticResource DisconnectedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource ConnectedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <!-- Header: Name + connection badge -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Border Grid.Column="1" Padding="8,2" CornerRadius="12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#339E9E9E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Background" Value="#334CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding IsConnected, Converter={StaticResource BoolToConnText}}"
                                               FontSize="12" Foreground="White"/>
                                </Border>
                            </Grid>

                            <!-- V / A / W -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding VoltageText}" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="V" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding CurrentText}" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="A" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding PowerText}" FontSize="24" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="W" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                </StackPanel>
                            </Grid>

                            <!-- Protocol -->
                            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13">
                                协议: <Run Text="{Binding Protocol}"/>
                            </TextBlock>

                            <!-- Actions -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="开启/关闭"
                                        Command="{Binding TogglePortCommand}"
                                        Style="{StaticResource PortCardButtonStyle}"
                                        Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="端口控制"
                                        Command="{Binding OpenControlCommand}"
                                        Style="{StaticResource PortCardButtonStyle}"
                                        Margin="4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run Text="{Binding ScanResults.Count, StringFormat=扫描到 {0} 个设备}"/>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox ItemsSource="{Binding ScanResults}"
                              SelectedItem="{Binding SelectedScanResult}"
                              DisplayMemberPath="Name"
                              MinWidth="200"
                              Margin="0,0,8,0"/>
                    <Button Content="连接"
                            Command="{Binding ConnectCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>