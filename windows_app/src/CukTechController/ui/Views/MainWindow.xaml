<Window x:Class="CukTechController.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CukTechController.ViewModels"
        xmlns:c="clr-namespace:CukTechController.Controls"
        Title="酷态科控制器" Height="760" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style TargetType="ListBoxItem" x:Key="ScanResultItemStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>

    <!-- 主容器：不透明深色主题，叠加在 Mica 效果之上 -->
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶部状态栏 ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <!-- 左：Logo + 连接指示灯 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                             x:Name="ConnIndicator">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource DisconnectedBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource ConnectedBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource AccentBlueBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="酷态科 CukTech" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- 中：连接状态 -->
                <TextBlock x:Name="StatusText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <!-- 右：按钮组 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔄 扫描" Command="{Binding ScanCommand}"
                            Style="{StaticResource ColorOSButton}" Margin="4,0"/>
                    <Button Content="🔗 连接" Command="{Binding ConnectCommand}"
                            Style="{StaticResource ColorOSButton}"
                            Background="{StaticResource AccentGreenBrush}"
                            Margin="4,0"/>
                    <Button Content="🔐 导入凭证" Click="Import_Click"
                            Style="{StaticResource ColorOSButton}" Margin="4,0"
                            Background="{StaticResource AccentPurpleBrush}"/>
                    <Button Content="⚙️" Click="Settings_Click"
                            Style="{StaticResource ColorOSButton}" Margin="4,0" Padding="12,8"/>
                    <Button Content="📋" Click="Log_Click"
                            Style="{StaticResource ColorOSButton}" Margin="4,0" Padding="12,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 错误提示条 ===== -->
        <Border Grid.Row="0" Panel.ZIndex="1"
                Background="#80EF4444" CornerRadius="4"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,-26" Padding="12,4"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="White" FontSize="12"/>
        </Border>

        <!-- ===== 中心辐射区 ===== -->
        <Grid Grid.Row="1">
            <!-- ===== 左侧：扫描结果列表 ===== -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="16,16,0,0" Width="240" MaxHeight="280"
                    Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                    BorderBrush="#1AFFFFFF" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="12,0">
                        <TextBlock Text="🔎 设备列表" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox Grid.Row="1"
                             x:Name="ScanListBox"
                             ItemsSource="{Binding ScanResults}"
                             SelectedItem="{Binding SelectedScanResult}"
                             ItemContainerStyle="{StaticResource ScanResultItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Margin="0,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource DisconnectedBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCuktech}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource ConnectedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="{Binding Name, TargetNullValue='(无名设备)', FallbackValue='(无名设备)'}"/>
                                            <Run Text="  · RSSI "/><Run Text="{Binding Rssi}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="10"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding DeviceId}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 背景装饰：辐射光线 -->
            <Canvas>
                <Line X1="510" Y1="200" X2="330" Y2="100"
                      Stroke="#14FFFFFF" StrokeThickness="1"/>
                <Line X1="510" Y1="200" X2="690" Y2="100"
                      Stroke="#14FFFFFF" StrokeThickness="1"/>
                <Line X1="510" Y1="200" X2="690" Y2="300"
                      Stroke="#14FFFFFF" StrokeThickness="1"/>
                <Line X1="510" Y1="200" X2="330" Y2="300"
                      Stroke="#14FFFFFF" StrokeThickness="1"/>
            </Canvas>

            <!-- 中心：功率环 + 充电头 -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" Y="-20"/>
                </Grid.RenderTransform>
                <c:PowerRingControl Width="280" Height="280"
                                    TotalPower="{Binding TotalPower}"
                                    ActiveCount="{Binding ActivePortCount}"/>
                <c:ChargerVisualControl Width="220" Height="220"
                                         ActivePorts="{Binding ActivePorts}"/>
            </Grid>

            <!-- ===== 4 端口快捷按钮（环形分布）===== -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="90" Height="90"
                    Tag="1"
                    MouseLeftButtonDown="PortCard_MouseLeftButtonDown">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="-240" Y="-140"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border Style="{StaticResource PortCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="C1" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding C1PortText}" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Border>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="90" Height="90"
                    Tag="2"
                    MouseLeftButtonDown="PortCard_MouseLeftButtonDown">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="240" Y="-140"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border Style="{StaticResource PortCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="C2" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding C2PortText}" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Border>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="90" Height="90"
                    Tag="3"
                    MouseLeftButtonDown="PortCard_MouseLeftButtonDown">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="240" Y="140"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border Style="{StaticResource PortCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="C3" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding C3PortText}" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Border>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="90" Height="90"
                    Tag="4"
                    MouseLeftButtonDown="PortCard_MouseLeftButtonDown">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="-240" Y="140"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border Style="{StaticResource PortCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text=" A" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding APortText}" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ===== 底部快捷操作 ===== -->
        <Border Grid.Row="2" Margin="16,4">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="⚡ 全部开启" Click="AllOn_Click"
                            Style="{StaticResource ColorOSButton}"
                            Background="{StaticResource AccentGreenBrush}"
                            Margin="8"/>
                    <Button Content="⏻ 全部关闭" Click="AllOff_Click"
                            Style="{StaticResource ColorOSButton}"
                            Background="{StaticResource WarningBrush}"
                            Margin="8" Padding="16,8"/>
                    <Button Content="🔌 断开" Click="Disconnect_Click"
                            Command="{Binding DisconnectCommand}"
                            Style="{StaticResource ColorOSButton}"
                            Background="{StaticResource ErrorBrush}"
                            Margin="8" Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 最底部错误/提示文本 ===== -->
        <Border Grid.Row="3" Margin="16,0,16,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBrush}" FontSize="11"
                       TextAlignment="Center" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
