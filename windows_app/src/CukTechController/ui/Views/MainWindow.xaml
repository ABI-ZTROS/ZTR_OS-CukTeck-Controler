<Window x:Class="CukTechController.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CukTechController.ViewModels"
        xmlns:c="clr-namespace:CukTechController.Controls"
        Title="酷态科控制器" Height="760" Width="1020"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBackgroundColor}">

    <!-- 深色主题全局 -->
    <FrameworkElement.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock" x:Key="HeaderText">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- ColorOS 端口卡片样式 -->
        <Style TargetType="Border" x:Key="PortCardStyle">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#40374151"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </FrameworkElement.Resources>

    <Grid>
        <!-- ===== 顶部状态栏 ===== -->
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <!-- 左：Logo + 标题 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                             Fill="{StaticResource AccentGreen}"/>
                    <TextBlock Text="酷态科 CukTech" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- 中：连接状态 -->
                <TextBlock x:Name="StatusText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="{Binding StatusMessage}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>

                <!-- 右：按钮组 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔄 扫描" Command="{Binding ScanCommand}"
                            Style="{StaticResource ColorOSButton}" Margin="4,0"/>
                    <Button Content="🔗 云登录" Click="CloudLogin_Click"
                            Style="{StaticResource ColorOSButton}" Margin="4,0"/>
                    <Button Content="📥 导入凭证" Click="Import_Click"
                            Style="{StaticResource ColorOSButton}" Margin="4,0"/>
                    <Button Content="⚙️" Click="Settings_Click"
                            Style="{StaticResource ColorOSButton}" Margin="4,0" Padding="12,8"/>
                    <Button Content="📋" Click="Log_Click"
                            Style="{StaticResource ColorOSButton}" Margin="4,0" Padding="12,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 中心辐射区 ===== -->
        <Grid Grid.Row="1">
            <!-- 背景装饰：辐射光线 -->
            <Canvas>
                <!-- 4 条从中心辐射到端口的淡光线 -->
                <Line X1="510" Y1="200" X2="330" Y2="100"
                      Stroke="#14FFFFFF" StrokeThickness="1"/>
                <Line X1="510" Y1="200" X2="690" Y2="100"
                      Stroke="#14FFFFFF" StrokeThickness="1"/>
                <Line X1="510" Y1="200" X2="690" Y2="300"
                      Stroke="#14FFFFFF" StrokeThickness="1"/>
                <Line X1="510" Y1="200" X2="330" Y2="300"
                      Stroke="#14FFFFFF" StrokeThickness="1"/>
            </Canvas>

            <!-- 中心：功率环 + 充电头 -->
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RenderTransform>
                    <TranslateTransform X="0" Y="-20"/>
                </Grid.RenderTransform>

                <!-- 功率环（最外层）-->
                <c:PowerRingControl Width="280" Height="280"
                                    TotalPower="{Binding TotalPower}"
                                    ActiveCount="{Binding ActivePortCount}"/>

                <!-- 充电头 SVG -->
                <c:ChargerVisualControl Width="220" Height="220"
                                         ActivePorts="{Binding ActivePorts}"/>
            </Grid>

            <!-- ===== 4 端口快捷按钮（环形分布）===== -->
            <!-- C1 左上 (-135°) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="90" Height="90" Margin="0,0,0,0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="-240" Y="-140"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border Style="{StaticResource PortCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="C1" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding C1PortText}" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- C2 右上 (-45°) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="90" Height="90">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="240" Y="-140"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border Style="{StaticResource PortCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="C2" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding C2PortText}" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- C3 右下 (45°) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="90" Height="90">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="240" Y="140"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border Style="{StaticResource PortCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="C3" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding C3PortText}" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Border>

            <!-- A 口 左下 (135°) -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="90" Height="90">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform X="-240" Y="140"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border Style="{StaticResource PortCardStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text=" A" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding APortText}" FontSize="10" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ===== 底部快捷操作 ===== -->
        <Border Grid.Row="2" Margin="16,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="⚡ 全部开启" Click="AllOn_Click"
                            Style="{StaticResource ColorOSButton}" Margin="8"/>
                    <Button Content="⏻ 全部关闭" Click="AllOff_Click"
                            Margin="8" Padding="16,8"/>
                    <Button Content="🔌 断开" Click="Disconnect_Click"
                            Margin="8" Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
