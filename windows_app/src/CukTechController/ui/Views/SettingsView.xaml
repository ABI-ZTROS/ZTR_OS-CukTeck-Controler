<Window x:Class="CukTechController.Views.SettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设备设置"
        Height="600" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="设备设置"
                       FontSize="20" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,16"/>

            <!-- PIID 5: 场景模式 -->
            <Border Style="{StaticResource PortCardStyle}">
                <StackPanel>
                    <TextBlock Text="场景模式 (PIID 5)" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <ComboBox ItemsSource="{Binding SceneModeOptions}"
                              SelectedValue="{Binding SceneMode}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- PIID 6: 息屏时间 -->
            <Border Style="{StaticResource PortCardStyle}">
                <StackPanel>
                    <TextBlock Text="息屏时间 (PIID 6)" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <ComboBox ItemsSource="{Binding ScreenOffOptions}"
                              SelectedValue="{Binding ScreenOffTime}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- PIID 13: 语言 -->
            <Border Style="{StaticResource PortCardStyle}">
                <StackPanel>
                    <TextBlock Text="语言 (PIID 13)" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <ComboBox ItemsSource="{Binding LanguageOptions}"
                              SelectedValue="{Binding Language}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- PIID 15/19/20: 开关项 -->
            <Border Style="{StaticResource PortCardStyle}">
                <StackPanel>
                    <TextBlock Text="开关设置" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <CheckBox Content="USB-A 小电流 (PIID 15)"
                              IsChecked="{Binding UsbASmallCurrent}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,8,0,0"/>
                    <CheckBox Content="空闲息屏 (PIID 19)"
                              IsChecked="{Binding IdleScreenOff}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,4,0,0"/>
                    <CheckBox Content="屏幕方向锁 (PIID 20)"
                              IsChecked="{Binding ScreenOrientationLock}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- PIID 8: 总倒计时 -->
            <Border Style="{StaticResource PortCardStyle}">
                <StackPanel>
                    <TextBlock Text="总倒计时 (分钟)" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="设置所有端口的总倒计时时间，0 表示关闭"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,4,0,0"/>
                    <TextBox Text="{Binding GlobalTimer, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" Padding="8,4"
                             HorizontalAlignment="Left"
                             Background="{StaticResource BackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource DisconnectedBrush}"
                             Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- 错误提示 -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource ErrorBrush}"
                       FontSize="13"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"
                       Margin="0,8,0,0"/>

            <!-- 保存按钮 -->
            <Button Content="保存设置"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource ColorOSButton}"
                    Margin="0,16,0,0"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InvertBoolConv}}"/>
        </StackPanel>
    </ScrollViewer>
</Window>