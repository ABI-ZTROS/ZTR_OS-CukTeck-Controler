<Window x:Class="CukTechController.Views.PortControlView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="端口控制"
        Height="650" Width="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{Binding PortName, StringFormat=端口 {0} 控制}"
                   FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,16"/>

        <!-- 端口开关 -->
        <Border Grid.Row="1" Style="{StaticResource PortCardStyle}">
            <StackPanel>
                <TextBlock Text="电源控制" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding IsOn}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="切换"
                            Command="{Binding TogglePortCommand}"
                            Style="{StaticResource ColorOSButton}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 倒计时 -->
        <Border Grid.Row="2" Style="{StaticResource PortCardStyle}">
            <StackPanel>
                <TextBlock Text="倒计时 (分钟)" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBox Text="{Binding CountdownMinutes, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" Padding="8,4"
                             Background="{StaticResource BackgroundBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource DisconnectedBrush}"/>
                    <Button Content="保存"
                            Command="{Binding SaveCountdownCommand}"
                            Style="{StaticResource ColorOSButton}"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 协议设置 -->
        <Border Grid.Row="3" Style="{StaticResource PortCardStyle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="协议设置" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding SupportedProtocols}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding}"
                                          Foreground="{StaticResource TextPrimaryBrush}"
                                          Margin="0,4"
                                          Command="{Binding DataContext.ToggleProtocolCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 错误提示 -->
        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource ErrorBrush}"
                   FontSize="13"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}"
                   Margin="0,8,0,0"/>
    </Grid>
</Window>