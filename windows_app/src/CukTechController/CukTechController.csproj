<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon />
    <AssemblyName>CukTechController</AssemblyName>
    <RootNamespace>CukTechController</RootNamespace>
    <Version>0.2.0</Version>
    <!-- WPF 不支持 NativeAOT; 发布使用 dotnet publish 加 self-contained -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WPF 明确不支持 trimming (NETSDK1168) -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- 🧩 MVVM 基础设施（MSMC 同款）-->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />

    <!-- 🎨 UI 主题（Material Design 深色科技感）-->
    <PackageReference Include="MaterialDesignThemes" Version="5.*" />

    <!-- 📦 依赖注入 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.*" />

    <!-- 📝 结构化日志 -->
    <PackageReference Include="Serilog" Version="4.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.*" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.*" />

    <!-- 🌐 现有依赖 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
  </ItemGroup>

</Project>
